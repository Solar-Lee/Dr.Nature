<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- # drn-backup: nightly database + uploads backup at 04:15 local time (P12-08). Installed by install.sh with __HOME__ replaced. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>drn.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/drn/bin/drn-backup.sh</string>
    <string>daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DOCKER_HOST</key><string>unix://__HOME__/.docker/run/docker.sock</string>
    <key>DOCKER_CONFIG</key><string>__HOME__/drn/docker-config</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/drn/logs/launchd-backup.out</string>
  <key>StandardErrorPath</key><string>__HOME__/drn/logs/launchd-backup.err</string>
</dict>
</plist>
