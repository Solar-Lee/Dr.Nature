<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- # drn-restore-check: weekly restore drill on Sunday 05:00 local time (P12-21). Installed by install.sh with __HOME__ replaced. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>drn.restore-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/drn/bin/drn-restore-check.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>DOCKER_HOST</key><string>unix://__HOME__/.docker/run/docker.sock</string>
    <key>DOCKER_CONFIG</key><string>__HOME__/drn/docker-config</string>
  </dict>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/drn/logs/launchd-restore-check.out</string>
  <key>StandardErrorPath</key><string>__HOME__/drn/logs/launchd-restore-check.err</string>
</dict>
</plist>
