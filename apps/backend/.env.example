# Every name here must be listed in docs/ENV.md (checked by scripts/check-env-names.mjs).
# LINE_OA_API_BASE_URL is test-only (a local stub) and is refused when NODE_ENV=production,
# so it is not listed here.
LINE_OA_CHANNEL_ID=
LINE_OA_CHANNEL_SECRET=
LINE_OA_FORWARD_URL=
