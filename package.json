{
  "name": "dr-nature",
  "private": true,
  "description": "Dr.Nature brand site — Medusa v2 backend + Next.js storefront (see docs/DEV_PLAN.md)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "bash scripts/test-all.sh",
    "lint:claims": "node scripts/claims-lint.mjs",
    "check:env": "node scripts/check-env-names.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "backend:dev": "turbo dev --filter=@drn/backend"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0"
    },
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}
